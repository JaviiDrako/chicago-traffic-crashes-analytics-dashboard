# Copy this file to .env before running the ingestion scripts.
# .env is ignored by Git and must never contain credentials or private keys.

export GCP_PROJECT_ID="traffic-crashes-warehouse"
export GCP_LOCATION="US"

export GCS_BUCKET_NAME="traffic-crashes-warehouse-raw"
export GCS_OBJECT_PATH="raw/Chicago_Traffic_Crashes.csv"

export RAW_DATASET="traffic_crashes_raw"
export RAW_TABLE="raw_traffic_crashes"
export SCHEMA_FILE="schemas/traffic_crashes_raw.json"

# This value belongs to the current CSV snapshot. Update it if the source file
# is replaced with a different version.
export EXPECTED_ROW_COUNT="1079880"
