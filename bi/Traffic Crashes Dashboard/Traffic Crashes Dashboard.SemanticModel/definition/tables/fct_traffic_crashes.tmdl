	column latitude
		dataType: double
		lineageTag: cde76d06-0102-46c5-9ac7-ba9f1477bd41
		summarizeBy: sum
		sourceColumn: latitude

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column longitude
		dataType: double
		lineageTag: b8d061b1-f7aa-46ae-97b6-e50c975491f7
		summarizeBy: sum
		sourceColumn: longitude

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Rounded latitude used to aggregate mapped crashes into a reproducible two-decimal geographic grid.
	column geo_grid_latitude =
			VAR _Latitude = 'fct_traffic_crashes'[latitude]
			VAR _Longitude = 'fct_traffic_crashes'[longitude]
			RETURN
				IF (
					'fct_traffic_crashes'[has_coordinates]
						&& _Latitude >= 41.60
						&& _Latitude <= 42.10
						&& _Longitude >= -88.00
						&& _Longitude <= -87.40,
					ROUND ( _Latitude, 2 )
				)
		dataType: double
		isHidden
		lineageTag: 5a5ae1e3-0b6c-4ce8-8dc7-4e8e1b28e2c1
		summarizeBy: none

	/// Rounded longitude used to aggregate mapped crashes into a reproducible two-decimal geographic grid.
	column geo_grid_longitude =
			VAR _Latitude = 'fct_traffic_crashes'[latitude]
			VAR _Longitude = 'fct_traffic_crashes'[longitude]
			RETURN
				IF (
					'fct_traffic_crashes'[has_coordinates]
						&& _Latitude >= 41.60
						&& _Latitude <= 42.10
						&& _Longitude >= -88.00
						&& _Longitude <= -87.40,
					ROUND ( _Longitude, 2 )
				)
		dataType: double
		isHidden
		lineageTag: 6d2d3adf-09c3-4be5-a2ed-0c5a4b0b9b6e
		summarizeBy: none

	/// Stable identifier for each two-decimal latitude/longitude grid cell used by the Azure Maps visual.
	column geo_grid_id =
			VAR _Latitude = 'fct_traffic_crashes'[geo_grid_latitude]
			VAR _Longitude = 'fct_traffic_crashes'[geo_grid_longitude]
			RETURN
				IF (
					NOT ISBLANK ( _Latitude ) && NOT ISBLANK ( _Longitude ),
					FORMAT ( _Latitude, "0.00", "en-US" ) & "|" & FORMAT ( _Longitude, "0.00", "en-US" )
				)
		dataType: string
		isHidden
		lineageTag: 88c1eb9b-1b41-46f2-83ba-4e2f3b6ef0fb
		summarizeBy: none

